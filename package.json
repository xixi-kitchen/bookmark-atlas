{
  "name": "bookmark-atlas",
  "version": "0.9.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-locales.mjs && wxt",
    "build": "npm run build:chrome",
    "build:chrome": "node scripts/generate-locales.mjs && wxt build -b chrome --mv3",
    "build:edge": "node scripts/generate-locales.mjs && wxt build -b edge --mv3",
    "build:safari": "node scripts/generate-locales.mjs && wxt build -b safari --mv3",
    "i18n:generate": "node scripts/generate-locales.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs chrome",
    "verify:manifest:edge": "node scripts/verify-manifest.mjs edge",
    "verify:manifest:safari": "node scripts/verify-manifest.mjs safari",
    "verify:release": "node scripts/verify-release.mjs",
    "zip": "npm run zip:chrome",
    "zip:chrome": "node scripts/generate-locales.mjs && wxt zip -b chrome --mv3",
    "zip:edge": "node scripts/generate-locales.mjs && wxt zip -b edge --mv3",
    "package:sync-test": "npm run build:chrome && node scripts/create-sync-test-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build:chrome && npm run verify:manifest && npm run verify:release",
    "check:edge": "npm run typecheck && npm run test && npm run build:edge && npm run verify:manifest:edge",
    "check:safari": "npm run typecheck && npm run test && npm run build:safari && npm run verify:manifest:safari"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@excalidraw/excalidraw": "^0.18.1",
    "@xyflow/react": "^12.8.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wxt": "^0.19.25"
  }
}
