{
  "name": "bookmark-atlas",
  "version": "0.9.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/generate-locales.mjs && wxt",
    "build": "node scripts/generate-locales.mjs && wxt build",
    "i18n:generate": "node scripts/generate-locales.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "verify:manifest": "node scripts/verify-manifest.mjs",
    "zip": "node scripts/generate-locales.mjs && wxt zip",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:manifest"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@excalidraw/excalidraw": "^0.18.1",
    "@xyflow/react": "^12.8.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/chrome": "^0.0.287",
    "@types/dagre": "^0.7.52",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "@wxt-dev/module-react": "^1.1.3",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vitest": "^2.1.8",
    "wxt": "^0.19.25"
  }
}
